{
  "name": "cliff-notes",
  "version": "0.1.0",
  "description": "Controlled LLM changelog generator (git-cliff + structured LLM)",
  "type": "module",
  "bin": {
    "cliff-notes": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cliff.toml",
    "cliff-notes.example.toml",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "prepublish": "bun run build",
    "prepare": "bun run build",
    "test": "bun test",
    "dev": "bun run src/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^2.0.0",
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "ai": "^4.3.0",
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
