{
  "name": "cliff-notes",
  "version": "0.1.0",
  "description": "Controlled LLM changelog generator (git-cliff + structured LLM)",
  "bin": {
    "cliff-notes": "./src/cli.ts"
  },
  "files": [
    "src",
    "cliff.toml",
    "cliff-notes.example.toml",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "prepublish": "bun run build",
    "prepare": "bun run build && lefthook install",
    "test": "bun test",
    "dev": "bun run src/cli.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.57",
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "ai": "^7.0.66",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^5.5.0"
  }
}
